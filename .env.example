# ─── Database ────────────────────────────────────────────────────────────────
# SQLite (default, works out of the box locally and on Vercel via the file path)
DATABASE_URL="file:./prisma/dev.db"

# ─── Session ─────────────────────────────────────────────────────────────────
# Must be at least 32 characters. Generate one with:
#   openssl rand -base64 32
SESSION_PASSWORD="replace-with-32+char-random-string-xxxxxxxx"

# ─── Admin ───────────────────────────────────────────────────────────────────
# Password to access the /admin panel. Change this before deploying.
ADMIN_PASSWORD="change-me-before-deploying"

# ─── Email (Resend) ──────────────────────────────────────────────────────────
# Get your key at https://resend.com
# Without a key, emails are printed to the server console (good for local dev).
RESEND_API_KEY=""

# TODO: Once you have a verified domain in Resend, update the fromAddress in
# lib/email.ts from "kookwleigh <onboarding@resend.dev>" to something like:
#   "kookwleigh <hello@yourdomain.com>"
# The onboarding@resend.dev address only works for sending to your own
# Resend-verified email address, not arbitrary recipients.

# ─── App ─────────────────────────────────────────────────────────────────────
# Your public deployment URL (no trailing slash). Used in email links.
APP_URL="http://localhost:3000"
