{
  "name": "kookwleigh",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "dev": "NODE_OPTIONS=--no-deprecation next dev",
    "build": "NODE_OPTIONS=--no-deprecation node scripts/sync-prisma-artifacts.mjs && NODE_OPTIONS=--no-deprecation prisma generate && NODE_OPTIONS=--no-deprecation next build",
    "db:migrate": "NODE_OPTIONS=--no-deprecation node scripts/sync-prisma-artifacts.mjs && NODE_OPTIONS=--no-deprecation node scripts/migrate.mjs",
    "start": "NODE_OPTIONS=--no-deprecation next start",
    "lint": "next lint",
    "postinstall": "node scripts/ensure-env.mjs && node scripts/sync-prisma-artifacts.mjs && prisma generate",
    "prisma:sync": "node scripts/sync-prisma-artifacts.mjs",
    "seed": "tsx prisma/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "@radix-ui/react-dialog": "^1.1.15",
    "@radix-ui/react-slot": "^1.2.4",
    "@radix-ui/react-tabs": "^1.1.13",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "date-fns": "^4.1.0",
    "framer-motion": "^12.38.0",
    "iron-session": "^8.0.4",
    "lucide-react": "^1.14.0",
    "next": "14.2.35",
    "prisma": "^6.19.3",
    "react": "^18",
    "react-day-picker": "^10.0.0",
    "react-dom": "^18",
    "resend": "^6.12.3",
    "tailwind-merge": "^3.6.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@types/node": "^20",
    "@types/react": "^18",
    "@types/react-dom": "^18",
    "eslint": "^8",
    "eslint-config-next": "14.2.35",
    "postcss": "^8",
    "tailwindcss": "^3.4.1",
    "tsx": "^4.21.0",
    "typescript": "^5"
  }
}
