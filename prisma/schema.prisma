generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "sqlite"
  url      = env("DATABASE_URL")
}

model Guest {
  id               String      @id @default(cuid())
  name             String
  email            String      @unique
  allergies        String?
  favoriteCuisines String?
  status           GuestStatus @default(WAITLISTED)
  position         Int
  createdAt        DateTime    @default(now())
  bookings         Booking[]

  @@index([status, position])
  @@index([createdAt])
}

enum GuestStatus {
  WAITLISTED
  INVITED
  SCHEDULED
  COMPLETED
}

model AvailableSlot {
  id        String   @id @default(cuid())
  date      DateTime
  startTime String
  endTime   String
  isBooked  Boolean  @default(false)
  createdAt DateTime @default(now())
  booking   Booking?

  @@index([date, isBooked])
}

model Booking {
  id            String         @id @default(cuid())
  guestId       String
  guest         Guest          @relation(fields: [guestId], references: [id], onDelete: Cascade)
  slotId        String?        @unique
  slot          AvailableSlot? @relation(fields: [slotId], references: [id], onDelete: SetNull)
  requestedDate DateTime?
  requestedTime String?
  status        BookingStatus  @default(PENDING)
  notes         String?
  createdAt     DateTime       @default(now())

  @@index([guestId, status])
  @@index([createdAt])
}

enum BookingStatus {
  PENDING
  CONFIRMED
  CANCELLED
}

model CompletedDinner {
  id               String   @id @default(cuid())
  guestName        String
  guestEmail       String
  allergies        String?
  favoriteCuisines String?
  dinnerDate       DateTime?
  dinnerTime       String?
  menu             String?
  notes            String?
  photoDataUrls    String?
  completedAt      DateTime @default(now())
  createdAt        DateTime @default(now())

  @@index([completedAt])
  @@index([guestEmail])
}
